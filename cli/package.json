{
  "name": "@queryschema/cli",
  "version": "1.0.0",
  "description": "Command-line interface for Query Schema",
  "type": "module",
  "bin": {
    "queryschema": "./dist/index.js",
    "dbstudio": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p .",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/queryschema-cli.cjs --banner:js=\"#!/usr/bin/env node\"",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
